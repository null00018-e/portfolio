<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Skills & Reflection | River Cooper</title>
<style>
    /* =========================
       BASIC SETTINGS
    ========================= */

    :root {
      --bg: #070b14;
      --bg2: #0d1424;
      --card: rgba(18, 28, 48, 0.75);
      --blue: #35a7ff;
      --cyan: #58e6ff;
      --purple: #8c5cff;
      --white: #f5f8ff;
      --gray: #aab6c8;
      --green: #48e09b;
      --border: rgba(255,255,255,0.09);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at 80% 10%, rgba(53,167,255,.15), transparent 30%),
        radial-gradient(circle at 10% 40%, rgba(140,92,255,.12), transparent 30%),
        var(--bg);
      color: var(--white);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    /* =========================
       NAVIGATION
    ========================= */

    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(7,11,20,.75);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .logo span {
      color: var(--cyan);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      color: var(--gray);
      font-size: .95rem;
      transition: .2s;
    }

    .nav-links a:hover {
      color: white;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 70px;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 50px;
      align-items: center;
    }

    .eyebrow {
      color: var(--cyan);
      font-size: .9rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: .95;
      letter-spacing: -4px;
      margin-bottom: 25px;
    }

    h1 span {
      background: linear-gradient(90deg, var(--cyan), var(--blue), var(--purple));
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 600px;
      color: var(--gray);
      font-size: 1.15rem;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .button {
      padding: 13px 22px;
      border-radius: 10px;
      font-weight: 700;
      transition: .2s;
      display: inline-block;
    }

    .primary {
      background: linear-gradient(90deg, var(--blue), var(--purple));
    }

    .secondary {
      border: 1px solid var(--border);
      background: rgba(255,255,255,.04);
    }

    .button:hover {
      transform: translateY(-3px);
    }

    /* ROBOT VISUAL */

    .robot-card {
      height: 400px;
      border: 1px solid var(--border);
      border-radius: 25px;
      background:
        linear-gradient(145deg, rgba(53,167,255,.12), rgba(140,92,255,.08)),
        var(--card);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 30px 80px rgba(0,0,0,.35);
    }

    .robot-placeholder {
      width: 75%;
      height: 65%;
      border: 2px dashed rgba(88,230,255,.35);
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--gray);
      padding: 30px;
    }

    .robot-placeholder strong {
      display: block;
      color: var(--cyan);
      font-size: 1.4rem;
      margin-bottom: 8px;
    }

    /* =========================
       SECTIONS
    ========================= */

    section {
      padding: 110px 0;
    }

    .section-title {
      margin-bottom: 50px;
    }

    .section-title .small {
      color: var(--cyan);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: .8rem;
      font-weight: bold;
    }

    .section-title h2 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin-top: 8px;
    }

    .section-title p {
      color: var(--gray);
      max-width: 700px;
      margin-top: 12px;
    }

    /* =========================
       ABOUT
    ========================= */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 30px;
    }

    .card h3 {
      margin-bottom: 12px;
    }

    .card p {
      color: var(--gray);
    }

    /* =========================
       ACHIEVEMENT
    ========================= */

    .achievement {
      border: 1px solid rgba(72,224,155,.25);
      background:
        linear-gradient(120deg, rgba(72,224,155,.08), rgba(53,167,255,.06)),
        var(--card);
      border-radius: 25px;
      padding: 40px;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 30px;
      align-items: center;
    }

    .achievement-icon {
      width: 90px;
      height: 90px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(72,224,155,.12);
      font-size: 2.5rem;
    }

    .achievement h3 {
      font-size: 1.7rem;
      margin-bottom: 7px;
    }

    .achievement p {
      color: var(--gray);
    }

    .tag {
      display: inline-block;
      color: var(--green);
      border: 1px solid rgba(72,224,155,.25);
      background: rgba(72,224,155,.08);
      padding: 5px 10px;
      border-radius: 50px;
      font-size: .75rem;
      margin-bottom: 10px;
    }

    /* =========================
       MEDBOT
    ========================= */

    .project-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 30px;
    }

    .project-description {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 35px;
    }

    .project-description h3 {
      font-size: 1.7rem;
      margin-bottom: 15px;
    }

    .project-description p {
      color: var(--gray);
      margin-bottom: 15px;
    }

    .project-description ul {
      padding-left: 20px;
      color: var(--gray);
    }

    .project-description li {
      margin: 7px 0;
    }

    /* =========================
       IMAGE PLACEHOLDERS
    ========================= */

    .image-box {
      border-radius: 18px;
      border: 2px dashed rgba(88,230,255,.25);
      background: rgba(255,255,255,.025);
      min-height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
      color: var(--gray);
      overflow: hidden;
    }

    .image-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 12px;
    }

    .image-box strong {
      display: block;
      color: var(--cyan);
      font-size: 1.2rem;
      margin-bottom: 8px;
    }

    .image-box span {
      font-size: .9rem;
    }

    .screenshots {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
      margin-top: 25px;
    }

    /* =========================
       PROCESS
    ========================= */

    .process {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .process-card {
      padding: 25px;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 16px;
    }

    .number {
      color: var(--cyan);
      font-size: .8rem;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .process-card p {
      color: var(--gray);
      font-size: .9rem;
    }

    /* =========================
       SKILLS
    ========================= */

    .skills {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .skill {
      border: 1px solid var(--border);
      background: rgba(255,255,255,.04);
      padding: 10px 16px;
      border-radius: 50px;
      color: var(--gray);
    }

    /* =========================
       CONTACT
    ========================= */

    .contact {
      text-align: center;
      padding: 70px 30px;
      border-radius: 25px;
      background:
        radial-gradient(circle at center, rgba(53,167,255,.13), transparent 60%),
        var(--card);
      border: 1px solid var(--border);
    }

    .contact p {
      color: var(--gray);
      max-width: 550px;
      margin: 15px auto 25px;
    }

    footer {
      padding: 35px 0;
      border-top: 1px solid var(--border);
      color: #758196;
      font-size: .85rem;
      text-align: center;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 800px) {

      .nav-links {
        display: none;
      }

      .hero-grid,
      .about-grid,
      .project-header {
        grid-template-columns: 1fr;
      }

      .robot-card {
        height: 300px;
      }

      .achievement {
        grid-template-columns: 1fr;
      }

      .screenshots {
        grid-template-columns: 1fr;
      }

      .process {
        grid-template-columns: 1fr 1fr;
      }

      h1 {
        letter-spacing: -2px;
      }
    }

    @media (max-width: 500px) {
      .process {
        grid-template-columns: 1fr;
      }

      section {
        padding: 75px 0;
      }
    }
  </style>
